[Unit]
Description=Wavelens companion bridge (receive-only radios -> Wavelens app over BLE)
# Wants, not Requires: run-bridge.sh restarts bluetooth itself after a failed advert, and with
# Requires that restart would stop this service too.
Wants=bluetooth.service
After=bluetooth.service

[Service]
Type=simple
# Feeds and options live in /etc/default/wavelens-bridge; edit that, not this file.
EnvironmentFile=-/etc/default/wavelens-bridge
ExecStart=/usr/local/lib/wavelens/run-bridge.sh
Restart=always
RestartSec=5
# rtl_433 / rtl_power can hang on the USB device when told to quit; don't wait systemd's default 90 s.
TimeoutStopSec=8
# The bridge registers a GATT server and advertisement with BlueZ over D-Bus and
# opens the SDR's USB device; root is the reliable way to get both on Raspberry Pi OS.
User=root
Nice=-5

[Install]
WantedBy=multi-user.target
