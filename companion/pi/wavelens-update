#!/bin/bash
# wavelens-update — keep a Wavelens companion Pi current. Installed to /usr/local/bin by install-service.sh.
#
#   wavelens-update check      fetch; record whether a newer version exists (no changes made)
#   wavelens-update apply      pull, install the bridge + admin + packs + firmware, restart, verify; roll back on failure
#   wavelens-update rollback   put the previous install back and restart
#   wavelens-update status     print the record (JSON) and exit 0 if up to date, 10 if an update is available
#   wavelens-update auto       what the nightly timer runs: check, then apply when WAVELENS_AUTO_UPDATE=1 and no phone is linked
#
# Source of truth: the public repo (https://github.com/pmcbrien/wavelens), checked out at $WAVELENS_SRC
# (default: the checkout this script was installed from, recorded in /etc/wavelens/source; else /opt/wavelens).
# The version is companion/VERSION in that checkout. Updates are free; the only network use is this pull.
# Everything else on the Pi stays as it was: /etc/default/wavelens-bridge (settings) and /etc/wavelens are never touched.
set -u

LIB=/usr/local/lib/wavelens
PREV=/usr/local/lib/wavelens.prev
STATE_DIR=/var/lib/wavelens
STATE=$STATE_DIR/update.json
RUN=/run/wavelens
DEFAULTS=/etc/default/wavelens-bridge
SRC_FILE=/etc/wavelens/source
FW_URL=https://github.com/pmcbrien/wavelens/releases/download/firmware
LOGF=$STATE_DIR/update.log      # the last apply/rollback, line by line; the admin page shows it after a restart
LOCKF=$RUN/update.lock

log() { echo "update: $*"; }
die() { echo "update: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "run with sudo"
mkdir -p "$STATE_DIR" "$RUN"

# apply / rollback restart wavelens-bridge and wavelens-admin. Started from the phone (the bridge) or the admin
# page, this script is a child of the very service it restarts, so the restart would kill it before the health
# check and the rollback. Run those two in a transient unit of their own and follow its log from here instead.
case "${1:-}" in apply|rollback)
    if [ -z "${WAVELENS_UPDATE_DETACHED:-}" ] && command -v systemd-run >/dev/null 2>&1; then
        unit="wavelens-update-run"
        if systemctl is-active -q "$unit" 2>/dev/null; then die "an update is already running"; fi
        systemctl reset-failed "$unit" 2>/dev/null || true
        : > "$LOGF"; rm -f "$STATE_DIR/update.rc"
        systemd-run --unit="$unit" --quiet --collect --setenv=WAVELENS_UPDATE_DETACHED=1 \
            ${WAVELENS_SRC:+--setenv=WAVELENS_SRC="$WAVELENS_SRC"} /usr/local/bin/wavelens-update "$@" \
            || die "could not start the update job"
        shown=0
        while :; do
            st=$(systemctl is-active "$unit" 2>/dev/null)
            n=$(wc -l < "$LOGF" 2>/dev/null || echo 0)
            [ "$n" -gt "$shown" ] && { sed -n "$((shown + 1)),${n}p" "$LOGF"; shown=$n; }
            case "$st" in active|activating|reloading) sleep 1 ;; *) break ;; esac
        done
        exit "$(cat "$STATE_DIR/update.rc" 2>/dev/null || echo 1)"
    fi
    exec 9>"$LOCKF"
    flock -n 9 || die "an update is already running"
    [ -n "${WAVELENS_UPDATE_REEXEC:-}" ] || exec > >(tee -a "$LOGF") 2>&1   # a re-exec already writes the log
    trap 'echo $? > "$STATE_DIR/update.rc"' EXIT ;;
esac

# Where the checkout is.
if [ -n "${WAVELENS_SRC:-}" ]; then SRC=$WAVELENS_SRC
elif [ -f "$SRC_FILE" ]; then SRC=$(cat "$SRC_FILE")
elif [ -d /opt/wavelens/.git ]; then SRC=/opt/wavelens
else SRC=$(ls -d /home/*/wavelens/.git 2>/dev/null | head -1 | xargs -r dirname); fi
[ -n "$SRC" ] && [ -d "$SRC/.git" ] || die "no checkout found; clone https://github.com/pmcbrien/wavelens to /opt/wavelens (or write its path to $SRC_FILE)"
# git refuses to touch a checkout owned by another user (root updating /home/pi/wavelens) unless told it's
# fine. This runs as root inside a systemd-run unit, which has no HOME, so --global silently did nothing and
# every fetch died with "dubious ownership". Write it to the system config (/etc/gitconfig) once instead, and
# also pass it on the command line for this run so a read-only /etc can't break the update either.
export HOME="${HOME:-/root}"
git config --system --get-all safe.directory 2>/dev/null | grep -qxF "$SRC" \
    || git config --system --add safe.directory "$SRC" 2>/dev/null || true
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$SRC"

installed() { cat "$LIB/VERSION" 2>/dev/null || echo "unknown"; }
checkout_version() { cat "$SRC/companion/VERSION" 2>/dev/null || echo "unknown"; }
remote_version() { git -C "$SRC" show origin/main:companion/VERSION 2>/dev/null || echo "unknown"; }
# A phone counts as linked only if the bridge said so recently: while linked it rewrites status.json with every
# hello (the app pings every 15 s), so a "linked" older than 2 minutes is left over from a bridge that died.
linked() { python3 -c "import json,sys,time; d=json.load(open(sys.argv[1])); print(1 if d.get('linked') and time.time() - float(d.get('at') or 0) < 120 else 0)" "$RUN/status.json" 2>/dev/null || echo 0; }
auto_enabled() { grep -qE '^WAVELENS_AUTO_UPDATE="?1"?' "$DEFAULTS" 2>/dev/null; }

write_state() {   # write_state <available|null> <last_result>
    local avail=$1 result=$2
    python3 - "$STATE" "$(installed)" "$avail" "$(git -C "$SRC" rev-parse --short origin/main 2>/dev/null)" "$result" "$(auto_enabled && echo 1 || echo 0)" <<'EOF'
import json, sys, time
path, installed, avail, commit, result, auto = sys.argv[1:]
json.dump({"installed": installed, "available": avail or None, "commit": commit, "checked_at": int(time.time()),
           "last_result": result, "auto": auto == "1"}, open(path, "w"))
EOF
}

do_fetch() {
    git -C "$SRC" fetch -q origin main 2>&1 | grep -v "^$" || true
    git -C "$SRC" rev-parse --verify -q origin/main >/dev/null || die "fetch failed (no network?)"
}

do_check() {
    do_fetch
    local have want
    have=$(installed); want=$(remote_version)
    if [ "$want" != "unknown" ] && [ "$want" != "$have" ]; then
        write_state "$want" "update available"
        log "installed $have, available $want"
        return 10
    fi
    write_state "" "up to date"
    log "up to date ($have)"
    return 0
}

install_files() {   # from $SRC into $LIB (same list as install-service.sh)
    local p=$SRC/companion/pi
    install -d "$LIB" "$LIB/packs" "$LIB/firmware"
    # every module the bridge might import, not a hand-kept list: a new .py (spotters.py, 4 Nov) that the
    # list forgot made the update fail preflight with ModuleNotFoundError and roll back
    install -m 0644 "$p"/*.py "$LIB/"
    install -m 0755 "$p/run-bridge.sh" "$LIB/"
    chmod 0755 "$LIB/wavelens_bridge.py" "$LIB/smartnet.py"
    [ -f "$LIB/wavelens_admin.py" ] && chmod 0755 "$LIB/wavelens_admin.py"
    install -m 0644 "$SRC"/packs/??.json "$LIB/packs/" 2>/dev/null || true
    install -m 0644 "$SRC/companion/VERSION" "$LIB/VERSION"
    install -m 0644 "$p/wavelens-bridge.default" "$LIB/wavelens-bridge.default"
    # never rewrite the running script in place: bash reads it as it goes
    install -m 0755 "$p/wavelens-update" /usr/local/bin/.wavelens-update.new && mv -f /usr/local/bin/.wavelens-update.new /usr/local/bin/wavelens-update
    [ -f "$p/wavelens-admin" ] && install -m 0755 "$p/wavelens-admin" /usr/local/bin/wavelens-admin
    [ -f "$p/wavelens-area" ] && install -m 0755 "$p/wavelens-area" /usr/local/bin/wavelens-area
    install -d /var/lib/wavelens/area /var/lib/wavelens/area/rr
    install -m 0644 "$p/wavelens-bridge.service" /etc/systemd/system/
    [ -f "$p/wavelens-admin.service" ] && install -m 0644 "$p/wavelens-admin.service" /etc/systemd/system/
    [ -f "$p/wavelens-update.service" ] && install -m 0644 "$p/wavelens-update.service" "$p/wavelens-update.timer" /etc/systemd/system/
    systemctl daemon-reload
}

fetch_firmware() {   # the Spotter firmware that matches this release, for the admin page's USB flasher; best effort
    # All or nothing: every chip's image lands in a staging folder first, and only a complete set replaces the
    # installed one and its VERSION. A release missing one chip's image used to leave that chip's old .bin in
    # place under the new VERSION, so the admin page flashed stale firmware it called current.
    local v c fw=$LIB/firmware stage
    v=$(curl -fsSL --max-time 20 "$FW_URL/VERSION" 2>/dev/null | tr -d '[:space:]') || return 0
    [ -n "$v" ] || return 0
    [ "$(cat "$fw/VERSION" 2>/dev/null)" = "$v" ] && return 0
    stage=$fw/.new; rm -rf "$stage"; mkdir -p "$stage" || return 0
    for c in esp32 esp32s3 esp32c3 esp32c5 esp32c6; do
        if ! curl -fsSL --max-time 120 -o "$stage/wavelens-$c.bin" "$FW_URL/wavelens-$c.bin" || [ ! -s "$stage/wavelens-$c.bin" ]; then
            log "Spotter firmware $v has no wavelens-$c.bin; keeping $(cat "$fw/VERSION" 2>/dev/null || echo 'what is installed')"
            rm -rf "$stage"; return 0
        fi
    done
    for c in esp32 esp32s3 esp32c3 esp32c5 esp32c6; do mv -f "$stage/wavelens-$c.bin" "$fw/wavelens-$c.bin"; done
    echo "$v" > "$stage/VERSION" && mv -f "$stage/VERSION" "$fw/VERSION"
    rm -rf "$stage"
    log "Spotter firmware $v downloaded"
}

restarts() { systemctl show -p NRestarts --value wavelens-bridge 2>/dev/null || echo 0; }
bridge_error() {   # the bridge's own last complaint since $1, in one line, for update.json and the admin page
    journalctl -u wavelens-bridge --since "$1" --no-pager -o cat 2>/dev/null \
        | grep -E "Error|error:|Traceback|not found|No such|failed" | grep -v "PLL not locked" | tail -1 | cut -c1-200
}
healthy() {   # started after $1 (a journal timestamp), got as far as advertising, and is not crash-looping
    local since=$1 r0 i=0
    r0=$(restarts)
    while [ $i -lt 25 ]; do
        sleep 1; i=$((i + 1))
        [ "$(restarts)" = "$r0" ] || return 1          # systemd had to restart it: it crashed
        systemctl is-active -q wavelens-bridge || continue
        if journalctl -u wavelens-bridge --since "$since" --no-pager -o cat 2>/dev/null | grep -q "advertising as\|bridge: hardware"; then
            sleep 3; [ "$(restarts)" = "$r0" ] && systemctl is-active -q wavelens-bridge; return
        fi
    done
    # up for 25 s with no restart counts even without the log line (e.g. Bluetooth slow to come up)
    [ "$(restarts)" = "$r0" ] && systemctl is-active -q wavelens-bridge
}
# Everything an update writes, beyond $LIB itself; copied into $PREV/.sys so a rollback restores all of it.
SYS_FILES="/usr/local/bin/wavelens-update /usr/local/bin/wavelens-admin /etc/systemd/system/wavelens-bridge.service
/etc/systemd/system/wavelens-admin.service /etc/systemd/system/wavelens-update.service /etc/systemd/system/wavelens-update.timer"

snapshot_good() {   # $LIB (+ system files) -> $PREV, the version a failed update falls back to
    rm -rf "$PREV.new"; cp -a "$LIB" "$PREV.new" || return 1
    mkdir -p "$PREV.new/.sys"
    local f; for f in $SYS_FILES; do [ -f "$f" ] && cp -a "$f" "$PREV.new/.sys/$(basename "$f")"; done
    rm -rf "$PREV"; mv "$PREV.new" "$PREV"
}

preflight() {   # the new code at least loads on this Pi's Python, before anything is restarted
    local out
    out=$(cd /tmp && timeout 30 python3 "$LIB/wavelens_bridge.py" --help 2>&1 >/dev/null) \
        || { echo "bridge does not load: $(printf '%s' "$out" | tail -1 | cut -c1-200)"; return 1; }
    if [ -f "$LIB/wavelens_admin.py" ]; then
        out=$(cd /tmp && timeout 30 python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$LIB/wavelens_admin.py" 2>&1) \
            || { echo "admin page does not load: $(printf '%s' "$out" | tail -1 | cut -c1-200)"; return 1; }
    fi
    bash -n /usr/local/bin/wavelens-update 2>/dev/null || { echo "updater script is broken"; return 1; }
}

do_apply() {
    do_fetch
    local have want t0 why
    have=$(installed); want=$(remote_version)
    if [ "$want" = "$have" ] && [ "${1:-}" != "--force" ]; then log "already on $have"; write_state "" "up to date"; return 0; fi
    # Run the updater that ships with the new version, not the one installed now: an old updater installs
    # the new bridge with its old file list and old checks. Once per run (WAVELENS_UPDATE_REEXEC).
    if [ -z "${WAVELENS_UPDATE_REEXEC:-}" ]; then
        local next=/usr/local/bin/.wavelens-update.next
        if git -C "$SRC" show origin/main:companion/pi/wavelens-update > "$next" 2>/dev/null \
            && bash -n "$next" && ! cmp -s "$next" /usr/local/bin/wavelens-update; then
            chmod 0755 "$next" && mv -f "$next" /usr/local/bin/wavelens-update
            log "updater changed; continuing with the new one"
            WAVELENS_UPDATE_REEXEC=1 exec /usr/local/bin/wavelens-update apply ${1:+"$1"}
        fi
        rm -f "$next"
    fi
    log "updating $have -> $want"
    # Fall back to what is running now only if it is actually working; a bridge that is already broken
    # (or crash-looping) must not overwrite the last good copy.
    if [ -d "$LIB" ] && { [ ! -d "$PREV" ] || bridge_ok_now; }; then
        snapshot_good || die "could not save a copy of the current version; nothing changed"
    else
        log "keeping the saved copy of $(cat "$PREV/VERSION" 2>/dev/null || echo 'the previous version') to fall back to (the current one isn't running properly)"
    fi
    git -C "$SRC" reset -q --hard origin/main || die "checkout failed; nothing changed"
    if ! ( set -e; install_files ); then
        log "installing $want failed part-way; putting the saved version back"
        do_rollback; write_state "$want" "update to $want could not be installed, so the saved version was put back"; return 1
    fi
    if ! why=$(preflight); then
        log "$want would not start on this Pi ($why); putting the saved version back"
        do_rollback; write_state "$want" "update to $want would not start on this Pi ($why), so the saved version was put back"; return 1
    fi
    fetch_firmware
    t0=$(date '+%Y-%m-%d %H:%M:%S')
    systemctl restart wavelens-bridge
    systemctl is-enabled -q wavelens-admin 2>/dev/null && systemctl restart wavelens-admin || true
    if healthy "$t0"; then
        write_state "" "updated to $want"
        log "done: $want is running"
        return 0
    fi
    why=$(bridge_error "$t0")
    log "the new bridge did not start${why:+ ($why)}; putting the saved version back"
    do_rollback
    write_state "$want" "update to $want did not start, so $(installed) was put back${why:+ — $why}"
    return 1
}

bridge_ok_now() {   # running, and no restart in the last 30 s
    systemctl is-active -q wavelens-bridge || return 1
    local r0; r0=$(restarts); sleep 30
    [ "$(restarts)" = "$r0" ] && systemctl is-active -q wavelens-bridge
}

do_rollback() {
    [ -d "$PREV" ] || die "nothing saved to roll back to"
    local t0 f
    rm -rf "$LIB.failed"; [ -d "$LIB" ] && mv "$LIB" "$LIB.failed"; cp -a "$PREV" "$LIB"
    if [ -d "$LIB/.sys" ]; then
        for f in $SYS_FILES; do
            [ -f "$LIB/.sys/$(basename "$f")" ] || continue
            cp -a "$LIB/.sys/$(basename "$f")" "$f.rb" && mv -f "$f.rb" "$f"
        done
        rm -rf "$LIB/.sys"
    fi
    systemctl daemon-reload
    t0=$(date '+%Y-%m-%d %H:%M:%S')
    systemctl restart wavelens-bridge
    systemctl is-enabled -q wavelens-admin 2>/dev/null && systemctl restart wavelens-admin || true
    if healthy "$t0"; then
        log "rolled back to $(installed); the bridge is running"
    else
        log "rolled back to $(installed), but the bridge still isn't running: $(bridge_error "$t0")"
        return 1
    fi
}

case "${1:-}" in
    check) do_check ;;
    apply) do_apply "${2:-}" ;;
    rollback) if do_rollback; then write_state "" "rolled back to $(installed)"; else write_state "" "rolled back to $(installed), but the bridge is not running"; exit 1; fi ;;
    status) cat "$STATE" 2>/dev/null || echo '{"installed":"'"$(installed)"'","available":null}'; echo; [ "$(installed)" = "$(checkout_version)" ] && exit 0 || exit 10 ;;
    auto)
        # the same lock apply/rollback take: a nightly run must not fetch, reset the checkout or install while one
        # started from the phone or the admin page is half-way through (or the other way round)
        exec 9>"$LOCKF"
        flock -n 9 || { log "an update is already running; next time"; exit 0; }
        # this run already holds the lock and is not a child of the services it restarts, so if do_apply
        # re-execs the new updater, that must carry on here rather than start a detached job of its own
        export WAVELENS_UPDATE_DETACHED=1
        do_check; rc=$?
        if [ $rc -eq 10 ] && auto_enabled; then
            if [ "$(linked)" = "1" ]; then log "update available but a phone is connected; next time"; exit 0; fi
            do_apply
        fi ;;
    *) sed -n '2,10p' "$0"; exit 2 ;;
esac
