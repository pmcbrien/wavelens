# /etc/default/wavelens-bridge — settings for wavelens-bridge.service.
# After editing: sudo systemctl restart wavelens-bridge

# RTL-SDR decoding with rtl_433. Hops 315 / 433.92 / 915 MHz every 30 s with fixed gain.
# Leave empty if no RTL-SDR is plugged in.
WAVELENS_RTL433="-f 315M -f 433.92M -f 915M -H 30 -g 40"

# Extra bridge flags. Examples:
#   --hackrf-sweep                          HackRF energy sweep of the whole 1 MHz–6 GHz range (~1 s a pass),
#                                           every carrier labelled by band; see README "HackRF: what the full sweep labels"
#   --hackrf-sweep --hackrf-range 5600:5950 HackRF on 5.8 GHz video only (faster passes)
#   HackRF + two RTL-SDRs on one Pi: use a powered USB hub (diagrams/pi-hackrf-2sdr.svg)
#   --rtl-power 902M:928M:25k --rtl-power 1240M:1300M:100k --rtl-power 1559M:1610M:100k --rtl-power-device 00001090 --rtl-power-dwell 6
#                                           RTL-SDR sweeps: 900 MHz ISM, 1.2 GHz video links, GPS (jammer check)
#   --rtl-power 150M:174M:12.5k --rtl-power 806M:815M:12.5k --rtl-power-device 00001090
#                                           RTL-SDR sweeps, VHF and 800 MHz taking turns on the dongle
#                                           with that serial (rtl_test lists serials); give rtl_433 the
#                                           other one with -d :SERIAL in WAVELENS_RTL433
#   --dump1090 localhost:30003              aircraft from dump1090 / readsb (needs a second dongle)
#   --fcc-pack /usr/local/lib/wavelens/fcc-local.json
#   --name Wavelens-Car                     the name the app lists under Find
WAVELENS_ARGS=""
